# Copiar este archivo a .env y completar los valores para desarrollo local.
# .env NO se versiona (ver .gitignore).

NODE_ENV=development
PORT=3000

# Debe coincidir con lo que expone docker-compose.yml en la raíz del repo.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=ecommerce
DATABASE_PASSWORD=ecommerce
DATABASE_NAME=ecommerce

# Origen permitido por CORS para las requests del frontend (Vite).
CORS_ORIGIN=http://localhost:5173

# CU-16: URL base con la que se arma el link a cada imagen de producto
# guardada en backend/uploads/ (LocalStorageService).
PUBLIC_ASSETS_URL=http://localhost:3000

# Secrets de JWT. En desarrollo, cualquier string largo sirve
# (generar uno real con: openssl rand -hex 32). Nunca reusar el mismo
# valor para access y refresh.
JWT_ACCESS_SECRET=change-me-access-change-me-access-32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-change-me-refresh-32
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

# CU-07 / CU-08: vencimiento de los tokens de un solo uso.
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_HOURS=1

# CU-06: bloqueo por intentos fallidos de login, por cuenta y por IP.
LOGIN_ACCOUNT_MAX_ATTEMPTS=5
LOGIN_ACCOUNT_LOCKOUT_WINDOW_MIN=15
LOGIN_ACCOUNT_LOCKOUT_DURATION_MIN=15
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_IP_LOCKOUT_WINDOW_MIN=15
LOGIN_IP_LOCKOUT_DURATION_MIN=15

# CU-20: máximo de correos por cuenta y plantilla dentro de la ventana.
EMAIL_RATE_LIMIT_MAX_PER_HOUR=3
